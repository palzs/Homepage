{
  "manifest_version": 3,
  "name": "Palzs Homepage",
  "version": "1.0.0",
  "description": "Personal homepage: multi-engine search + local browser bookmarks.",
  "permissions": ["bookmarks", "favicon"],
  "icons": {
    "16": "icons/extension-16.png",
    "32": "icons/extension-32.png",
    "48": "icons/extension-48.png",
    "128": "icons/extension-128.png"
  },
  "chrome_url_overrides": {
    "newtab": "index.html"
  }
}
